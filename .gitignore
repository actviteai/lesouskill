# LeSou public skill
work/
.worktrees/
*.key
*.pem

# Environment files (unused today; deny so a stray dotenv is never committed)
.env
.env.*
.envrc
!.env.example
!.env.sample
!.env.template

# --- Go (github/gitignore Go.gitignore) ---
# If you prefer the allow list template instead of the deny list, see community template:
